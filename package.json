{
  "name": "govintel-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Software Project Intelligence, Planning, Execution and Governance Platform",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm --filter=@govintel/web build",
    "dev": "pnpm --filter=@govintel/web dev",
    "typecheck": "tsc --build && pnpm --filter=@govintel/web typecheck",
    "typecheck:clean": "tsc --build --force",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:count": "node scripts/count-tests.mjs",
    "audit:deps": "pnpm audit --audit-level=moderate",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "clean": "node scripts/clean.mjs",
    "docs:permissions": "node --experimental-strip-types scripts/generate-permissions-matrix.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "docs:check": "node scripts/generate-icons.mjs --check && node --experimental-strip-types scripts/generate-permissions-matrix.mjs --check && node --experimental-strip-types scripts/generate-twin-schema.mjs --check && node --experimental-strip-types scripts/generate-rule-docs.mjs --check && node --experimental-strip-types scripts/generate-calculation-docs.mjs --check && node --experimental-strip-types scripts/generate-traceability-docs.mjs --check && node --experimental-strip-types scripts/generate-threat-model.mjs --check && node --experimental-strip-types scripts/generate-impact-docs.mjs --check && node --experimental-strip-types scripts/generate-governance-docs.mjs --check && node --experimental-strip-types scripts/generate-responsive-docs.mjs --check",
    "docs:twin": "node --experimental-strip-types scripts/generate-twin-schema.mjs",
    "docs:rules": "node --experimental-strip-types scripts/generate-rule-docs.mjs",
    "docs:calc": "node --experimental-strip-types scripts/generate-calculation-docs.mjs",
    "docs:trace": "node --experimental-strip-types scripts/generate-traceability-docs.mjs",
    "docs:threats": "node --experimental-strip-types scripts/generate-threat-model.mjs",
    "docs:impact": "node --experimental-strip-types scripts/generate-impact-docs.mjs",
    "docs:governance": "node --experimental-strip-types scripts/generate-governance-docs.mjs",
    "docs:responsive": "node --experimental-strip-types scripts/generate-responsive-docs.mjs",
    "migrate": "node --experimental-strip-types scripts/migrate.mjs",
    "verify:isolation": "node --experimental-strip-types scripts/verify-pooled-isolation.mjs",
    "seed:staging": "node scripts/seed-staging.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@material-symbols/svg-400": "0.47.0",
    "@opennextjs/cloudflare": "^1.20.4",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "22.20.1",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "axe-core": "4.13.0",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11",
    "wrangler": "^4.127.1"
  },
  "dependencies": {
    "@neon/config": "^1.1.0",
    "@neon/env": "^1.1.6",
    "postgres": "^3.4.9"
  }
}
