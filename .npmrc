# Strict by default: no phantom dependencies. A package must declare what it imports.
node-linker=isolated
strict-peer-dependencies=false
auto-install-peers=true
# Store lives on E: - C: has limited free space (docs/REPOSITORY_REALITY.md 2.3)
store-dir=E:/.pnpm-store/v11
cache-dir=E:/.pnpm-cache
state-dir=E:/.pnpm-state
