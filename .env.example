# Copy to .env.local for development. Never commit a filled-in copy.
# Dev and test use PGlite (embedded Postgres) and need no DATABASE_URL - see ADR-0002.

NODE_ENV=development
LOG_LEVEL=info

# Required in preview / staging / production only.
# DATABASE_URL=postgresql://user:password@host:5432/database

# Signing key for guest session cookies. Minimum 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=

# External-AI policy (plan section 19): DISABLED | REDACTED_ONLY | APPROVED_PROVIDERS_ONLY | USER_CHOICE
EXTERNAL_AI_MODE=USER_CHOICE

# Guest project lifetime before automatic expiry (gap-spec section 5.3)
GUEST_PROJECT_TTL_HOURS=72

# Deployed commit SHA, surfaced by production verification (plan section 28)
# APP_VERSION=
